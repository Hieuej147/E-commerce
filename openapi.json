  "info": {
    "title": "E-Commerce API",
    "description": "Microservice E-Commerce REST API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": { "scheme": "bearer", "bearerFormat": "JWT", "type": "http" }
    },
    "schemas": {
      "CurrentUserDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "clerkId": { "type": "string" },
          "email": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "displayName": { "type": "string" },
          "imageUrl": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        },
        "required": [
          "id",
          "clerkId",
          "email",
          "firstName",
          "lastName",
          "displayName",
          "imageUrl",
          "role",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "MoneyDto": {
        "type": "object",
        "properties": {
          "amountMinor": { "type": "number" },
          "currency": { "type": "string" }
        },
        "required": ["amountMinor", "currency"]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "$ref": "#/components/schemas/MoneyDto" },
          "stockQuantity": { "type": "number" },
          "status": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "sku": { "type": "string" },
          "categorySlug": { "type": "string" },
          "reorderPoint": { "type": "number" },
          "images": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "colors": { "type": "array", "items": { "type": "string" } },
          "sizes": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "id",
          "slug",
          "name",
          "description",
          "price",
          "stockQuantity",
          "status",
          "createdAt",
          "updatedAt",
          "sku",
          "categorySlug",
          "reorderPoint",
          "images",
          "colors",
          "sizes"
        ]
      },
      "PageInfoDto": {
        "type": "object",
        "properties": {
          "hasNextPage": { "type": "boolean" },
          "nextPageToken": { "type": "string" }
        },
        "required": ["hasNextPage", "nextPageToken"]
      },
      "ListProductsResponseDto": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductDto" }
          },
          "pageInfo": { "$ref": "#/components/schemas/PageInfoDto" }
        },
        "required": ["products", "pageInfo"]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "quantity": { "type": "number" }
        },
        "required": ["productId", "quantity"]
      },
      "ShippingAddressDto": {
        "type": "object",
        "properties": {
          "recipientName": { "type": "string" },
          "phone": { "type": "string" },
          "line1": { "type": "string" },
          "line2": { "type": "string" },
          "city": { "type": "string" },
          "province": { "type": "string" },
          "postalCode": { "type": "string" },
          "countryCode": { "type": "string" }
        },
        "required": [
          "recipientName",
          "phone",
          "line1",
          "city",
          "postalCode",
          "countryCode"
        ]
      },
      "CreateOrderBodyDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateOrderItemDto" }
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddressDto"
          },
          "idempotencyKey": { "type": "string" }
        },
        "required": ["items", "shippingAddress"]
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "productName": { "type": "string" },
          "quantity": { "type": "number" },
          "unitPrice": { "$ref": "#/components/schemas/MoneyDto" },
          "lineTotal": { "$ref": "#/components/schemas/MoneyDto" }
        },
        "required": [
          "productId",
          "productName",
          "quantity",
          "unitPrice",
          "lineTotal"
        ]
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OrderItemDto" }
          },
          "subtotal": { "$ref": "#/components/schemas/MoneyDto" },
          "total": { "$ref": "#/components/schemas/MoneyDto" },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddressDto"
          },
          "status": { "type": "string" },
          "paymentStatus": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" },
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" }
        },
        "required": [
          "id",
          "userId",
          "items",
          "subtotal",
          "total",
          "shippingAddress",
          "status",
          "paymentStatus",
          "createdAt",
          "updatedAt",
          "customerName",
          "customerEmail"
        ]
      },
      "ListOrdersResponseDto": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OrderDto" }
          },
          "pageInfo": { "$ref": "#/components/schemas/PageInfoDto" }
        },
        "required": ["orders", "pageInfo"]
      },
      "CheckoutBodyDto": {
        "type": "object",
        "properties": {
          "orderId": { "type": "string" },
          "successUrl": { "type": "string" },
          "cancelUrl": { "type": "string" },
          "idempotencyKey": { "type": "string" }
        },
        "required": ["orderId", "successUrl", "cancelUrl"]
      },
      "CheckoutResponseDto": {
        "type": "object",
        "properties": { "sessionUrl": { "type": "string" } },
        "required": ["sessionUrl"]
      },
      "PaymentDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "orderId": { "type": "string" },
          "userId": { "type": "string" },
          "amount": { "$ref": "#/components/schemas/MoneyDto" },
          "status": { "type": "string" },
          "provider": { "type": "string" },
          "providerPaymentId": { "type": "string" },
          "createdAt": { "type": "string" }
        },
        "required": [
          "id",
          "orderId",
          "userId",
          "amount",
          "status",
          "provider",
          "providerPaymentId",
          "createdAt"
        ]
      }
    }
  }
}
